DirectorySlash Off

RewriteEngine On

# Hapus slash di belakang semua URL, kecuali homepage
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} /$
RewriteRule ^(.+)/$ /$1 [R=302,L,NE]

# Routing index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]
